{
  "name": "git-curriculo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:auth": "npm run dev -w @gitcurriculo/auth-proxy",
    "dev:web": "npm run dev -w @gitcurriculo/web",
    "dev:extension": "npm run dev -w @gitcurriculo/extension",
    "build": "npm run build --workspaces --if-present",
    "bundle-extension": "node scripts/bundle-extension.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.6.3"
  }
}
