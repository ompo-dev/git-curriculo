{
  "name": "git-curriculo",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --env-file=.env run --cwd apps/api dev",
    "dev:web": "bun --env-file=.env run --cwd apps/web dev",
    "dev:desktop": "bun run --filter @gitcurriculo/desktop dev",
    "dev": "bunx concurrently -n api,web -c blue,green \"bun run dev:api\" \"bun run dev:web\"",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.6.3"
  }
}
